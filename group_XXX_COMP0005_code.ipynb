    "import timeit\n",
    "import matplotlib\n",
    "import random\n",
    "\n",
    "class ExperimentalFramework():\n",
    "    '''\n",
    "    A class to represent an experimental framework.\n",
    "\n",
    "    ...\n",
    "\n",
    "    Attributes\n",
    "    ----------\n",
    "    \n",
    "    n: maximum size of a tree\n",
    "    m: number of trees to build (number of searches + insertions at each size; size % i == 0 & size < n)\n",
    "    i: interval between timing a search and insertion\n",
    "    data_generator: an instance of TestDataGenerator for producing synthetic data\n",
    "    implementations: a list of balanced tree implementations\n",
    "    data_generator_methods: a list of synthetic data generation methods (all return a generator)\n",
    "\n",
    "    Methods\n",
    "    -------\n",
    "    \n",
    "    time_method_call: times the execution of a method (search or insert)\n",
    "    get_random_key_in_structure: returns a key in the structure for searching\n",
    "    get_random_key_not_in_structure: returns a key not in the structure for searching and inserting\n",
    "    get_keys: returns a key guaranteed to be in the stucture, and one that is guaranteed not to be\n",
    "    time_operations: times an insertion, and searches for a key in, and not in, the structure\n",
    "    record_times: adds the times to the dictionary\n",
    "    build_and_time_trees: builds balanced trees, timing operations as the tree grows\n",
    "    test_implementations [PUBLIC]: builds the test data for each implementation and data generation method\n",
    "    '''\n",
    "    \n",
    "    def __init__(self, n: int, m: int, i: int):\n",
    "        self.__n = n\n",
    "        self.__m = m\n",
    "        self.__i = i\n",
    "        self.__data_generator = TestDataGenerator(7, 0)\n",
    "        self.__implementations = (\n",
    "            TwoThreeTree,\n",
    "            LLRBBST,\n",
    "            AVLTree\n",
    "        )\n",
    "        self.__data_generator_methods = (\n",
    "            self.__data_generator.uniform_data,\n",
    "            self.__data_generator.normal_data,\n",
    "            self.__data_generator.sorted_data,\n",
    "            self.__data_generator.reverse_sorted_data,\n",
    "        )\n",
    "    \n",
    "    \n",
    "    def __time_method_call(self, method, *args):\n",
    "        return timeit.timeit(lambda: method(*args), number=1)\n",
    "\n",
    "\n",
    "    def __get_random_key_in_structure(self, keys_in_structure: list):\n",
    "        return random.choice(keys_in_structure) if len(keys_in_structure) > 0 else None\n",
    "\n",
    "\n",
    "    def __get_random_key_not_in_structure(self, structure: AbstractSearchInterface, data_generator):\n",
    "        key = next(data_generator)\n",
    "        while structure.searchElement(key):\n",
    "            key = next(data_generator)\n",
    "        return key\n",
    "    \n",
    "\n",
    "    def __get_keys(self, structure: AbstractSearchInterface, data_generator, keys_in_structure: list):\n",
    "        in_structure = self.__get_random_key_in_structure(keys_in_structure)\n",
    "        not_in_structure = self.__get_random_key_not_in_structure(structure, data_generator)\n",
    "        return in_structure, not_in_structure\n",
    "\n",
    "\n",
    "    def __time_operations(self, structure: AbstractSearchInterface, in_key, not_in_key):\n",
    "        insert_method, search_method = getattr(structure, 'insertElement'), getattr(structure, 'searchElement')\n",
    "        search_in = self.__time_method_call(search_method, in_key)\n",
    "        search_not_in = self.__time_method_call(search_method, not_in_key)\n",
    "        insert = self.__time_method_call(insert_method, not_in_key)\n",
    "        return insert, search_in, search_not_in\n",
    "    \n",
    "\n",
    "    def __record_times(self, times_dict: dict[str, dict[int, list[float]]], size, insert, search_in, search_not_in):\n",
    "        if size in times_dict['insert']:\n",
    "            times_dict['insert'][size].append(insert)\n",
    "            times_dict['search_in'][size].append(search_in)\n",
    "            times_dict['search_not_in'][size].append(search_not_in)\n",
    "        else:\n",
    "            times_dict['insert'][size] = [insert]\n",
    "            times_dict['search_in'][size] = [search_in]\n",
    "            times_dict['search_not_in'][size] = [search_not_in]\n",
    "\n",
    "\n",
    "    def __build_and_time_trees(self, implementation: type[AbstractSearchInterface], data_generator_method):\n",
    "        times = {'insert': dict(), 'search_in': dict(), 'search_not_in': dict()}\n",
    "        for _ in range(self.__m):\n",
    "            structure = implementation()\n",
    "            data_generator = data_generator_method()\n",
    "            keys_in_structure = list()\n",
    "            for size in range(self.__n):\n",
    "                in_key, not_in_key = self.__get_keys(structure, data_generator, keys_in_structure)\n",
    "                keys_in_structure.append(not_in_key)\n",
    "                if size % self.__i == 0 and size > 0:\n",
    "                    insert, search_in, search_not_in = self.__time_operations(structure, in_key, not_in_key)\n",
    "                    self.__record_times(times, size, insert, search_in, search_not_in)\n",
    "                else:\n",
    "                    structure.insertElement(not_in_key)\n",
    "        return times\n",
    "    \n",
    "\n",
    "    def test_implementations(self):\n",
    "        results = dict()\n",
    "        for implementation in self.__implementations:\n",
    "            distribution_results = dict()\n",
    "            for distribution in self.__data_generator_methods:\n",
    "                times = self.__build_and_time_trees(implementation, distribution)\n",
    "                distribution_results[distribution.__name__] = times\n",
    "            results[implementation.__name__] = distribution_results\n",
    "        return results\n",
    "\n"
   ],
